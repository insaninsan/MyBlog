---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="404 – Page Not Found" description="The page you're looking for doesn't exist.">
  <header class="mb-16">
    <h1 class="text-5xl font-semibold mb-4 text-[#333]">404</h1>
    <p class="text-gray-600 mb-6">The page you're looking for doesn't exist.</p>
    <a href="/" class="text-[#333] underline hover:opacity-70 transition-opacity">
      ← Back to blog
    </a>
  </header>
</MainLayout>
