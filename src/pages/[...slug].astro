---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content: PostContent } = await post.render();
---

<MainLayout title={post.data.title} description={post.data.description}>
  <article class="prose prose-lg prose-slate mx-auto max-w-full">
    <header class="mb-12">
      <h1 class="text-4xl font-semibold mb-4 text-[#333]">{post.data.title}</h1>
      <time class="text-sm text-gray-600" datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    </header>
    <PostContent />
  </article>
</MainLayout>

<style>
  /* Override typography plugin to use Ubuntu font */
  .prose {
    color: #333;
    font-family: 'Ubuntu', sans-serif;
  }
  
  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    font-family: 'Ubuntu', sans-serif;
    font-weight: 700;
    color: #333;
  }
  
  .prose p,
  .prose li,
  .prose blockquote {
    font-family: 'Ubuntu', sans-serif;
  }
  
  .prose a {
    color: #333;
  }
  
  .prose code {
    font-family: 'Courier New', monospace;
  }
</style>

